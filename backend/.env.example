# Primjer postavki. Aplikacija čita varijable okruženja; ovu datoteku ne učitava
# sama, služi kao popis onoga što se može postaviti.

# --- obavezno u produkciji ---
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=termini.example.com
DATABASE_URL=postgres://korisnik:lozinka@localhost:5432/termini
FRONTEND_URL=https://termini.example.com

# --- razvoj ---
# DJANGO_DEBUG=1 uključuje razvojni način: SQLite, e-pošta u konzoli.
DJANGO_DEBUG=0

# --- salon ---
BUSINESS_NAME=Salon Primjer
BOOKING_SLOT_STEP_MINUTES=15
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_MAX_DAYS_AHEAD=30
BOOKING_CANCEL_UNTIL_HOURS=2

# --- e-pošta (bez EMAIL_HOST poruke se ispisuju u konzolu) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=rezervacije@example.com
